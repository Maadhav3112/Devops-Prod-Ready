# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

MONGO_ROOT_USER=admin        #username for mongo root user
MONGO_ROOT_PASSWORD=password #password for mongo root user

PORT=3000

# Mongo connection string.
# Local (docker compose service name "mongo"):
#   mongodb://admin:password@mongo:27017/employeedb?authSource=admin
# Local (plain machine, no docker):
#   mongodb://admin:password@localhost:27017/employeedb?authSource=admin
MONGO_URI=mongodb://admin:password@localhost:27017/employeedb?authSource=admin